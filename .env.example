# =============================================================================
# LearnAI — Environment Variables
# =============================================================================
# Copy this file to .env.local for development.
# For production, set these in Vercel → Project → Settings → Environment Variables
# and in GitHub → Settings → Secrets and variables → Actions.
#
# Never commit .env.local. Never paste production secrets into chat.
# =============================================================================


# ═════════════════════════════════════════════════════════════════════════════
#  REQUIRED FOR PRODUCTION — 5 variables
#  Set these in BOTH Vercel and GitHub Actions secrets. Nothing else is
#  required to go live. The bundled OllaBridge gives you working AI with
#  zero config; the optional providers below only upgrade quality.
# ═════════════════════════════════════════════════════════════════════════════

# Neon Postgres (https://neon.tech) — use the pooled connection string.
# Format: postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/learnai

# `openssl rand -base64 32`
NEXTAUTH_SECRET=your-very-strong-random-secret-min-32-characters

# The public URL of your deployed app.
# Local dev: http://localhost:3000
# Production: https://YOUR-APP.vercel.app  (or your custom domain)
NEXTAUTH_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# Add these redirect URIs to the OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-APP.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ═════════════════════════════════════════════════════════════════════════════
#  OPTIONAL — public defaults (safe to commit, no secret needed)
#  These have sensible defaults in code. Override here if you want to swap
#  to a paid OllaBridge tier or pin a different model.
# ═════════════════════════════════════════════════════════════════════════════

OLLABRIDGE_URL=https://ruslanmv-ollabridge.hf.space
OLLABRIDGE_MODEL=qwen2.5:1.5b
# Bearer token from your OllaBridge dashboard, ONLY if you paired a premium
# tier. Leave blank to use the public unauthenticated endpoint.
OLLABRIDGE_TOKEN=


# ═════════════════════════════════════════════════════════════════════════════
#  OPTIONAL UPGRADES — paid AI providers
#  Each one is independent. Add the key in Vercel and it lights up
#  automatically in the /admin/providers fallback chain. Skip them all and
#  the bundled OllaBridge still serves every learner.
# ═════════════════════════════════════════════════════════════════════════════

# https://console.x.ai — new accounts receive $25 in promo credits (30 days)
XAI_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
#  OPTIONAL — local development conveniences
# ═════════════════════════════════════════════════════════════════════════════

# Public app metadata — Vercel injects NEXT_PUBLIC_VERCEL_URL automatically;
# set NEXT_PUBLIC_APP_URL only if you want it hard-pinned.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LearnAI

# Wikipedia REST etiquette: identifies LearnAI in the User-Agent header.
# Defaults to a sensible value in lib/wiki/client.ts.
WIKI_USER_AGENT=


# ═════════════════════════════════════════════════════════════════════════════
#  ADVANCED / FUTURE — not needed for the minimum production deploy
# ═════════════════════════════════════════════════════════════════════════════

# MCP Context Forge — A2A agent registry. Only used when you self-host
# ContextForge alongside the app to register custom AI teachers.
CONTEXTFORGE_URL=
CONTEXTFORGE_TOKEN=
CONTEXTFORGE_TEACHER_TAG=teacher

# PayPal — needed only if you wire the billing flow.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Local Ollama for the professor-interview-agent service (not the web app).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3:8b
