generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Certifications subsystem ───────────────────────────────────────────
// Vendors, levels, status, and question/session metadata for the
// database-backed certifications hub at /learn/certifications. See
// lib/certifications/db.ts for the read/write surface.

enum CertificationVendor {
  AWS
  AZURE
  GCP
  IBM
  OTHER
}

enum CertificationLevel {
  FOUNDATIONAL
  FUNDAMENTALS
  ASSOCIATE
  PROFESSIONAL
  EXPERT
  SPECIALTY
  ADVANCED
  OTHER
}

enum CertificationStatus {
  ACTIVE
  BETA
  RETIRING
  RETIRED
  DRAFT
  UNKNOWN
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SCENARIO
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionMode {
  QUICK_DRILL
  REVIEW
  FULL_EXAM
  CUSTOM
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed for credentials login
  role          Role      @default(STUDENT)
  /// Monotonic counter used by "sign out everywhere". The JWT
  /// callback rejects any token whose embedded version is < this
  /// value, forcing the user to sign in again on every device.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  teacherBookings Booking[] @relation("TeacherBookings")
  studentBookings Booking[] @relation("StudentBookings")

  teacherTransactions Transaction[] @relation("TeacherTransactions")
  studentTransactions Transaction[] @relation("StudentTransactions")

  // Per-user learning data — every row cascades on user delete so
  // "delete my account" leaves nothing orphaned in the database.
  projects              Project[]
  preferences           UserPreferences?
  progress              UserProgress?
  generatedQuizzes      GeneratedQuiz[]
  wikiTests             WikiTestSnapshot[]
  wikiAttempts          WikiAttemptRow[]
  certificationSessions CertificationSession[]
  certificationAnswers  CertificationAnswer[]
  certificationProgress CertificationProgress[]
  defenseSessions       DefenseSession[]
  letterforgeProgress   LetterforgeProgress[]
  letterforgeAttempts   LetterforgeAttempt[]
  builderStepProgress   BuilderStepProgress[]
  builderAchievements   UserBuilderAchievement[]
}

// ─── Per-user learning state ────────────────────────────────────────────
// Three small tables that together replace the process-local in-memory
// stores. Everything is scoped by userId and cascades on user delete.

model Project {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  worldSlug     String
  topic         String
  outcome       String   @default("")
  sources       String[]
  daysPerWeek   Int
  minutesPerDay Int
  deadline      String?
  prefs         String[]
  status        String   @default("idea")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, worldSlug])
  @@index([userId, createdAt])
}

model UserPreferences {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @id
  teacherId  String?  @default("nova")
  ttsEngine  String?  @default("web-speech")
  voiceLabel String?
  /// Free-form JSON for any future preference key that doesn't merit its own column.
  extra      Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

model UserProgress {
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @id
  xp         Int       @default(0)
  streak     Int       @default(0)
  lastSeen   DateTime?
  /// Per-world XP / streak / lastSeen breakdown. JSON because the world
  /// list grows over time and we don't want one column per world.
  worldStats Json      @default("{}")
  updatedAt  DateTime  @updatedAt
}

/// Persisted synthetic quizzes generated by the wizard at
/// `/learn/projects/new/synthetic`. Stored as a single JSON payload
/// (matching the `CanonicalQuiz` TypeScript type) so iteration on the
/// question schema doesn't require migrations — same approach as
/// `UserProgress.worldStats`.
model GeneratedQuiz {
  id         String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String
  sourceKind String // "wiki" | "upload" | "text"
  sourceRef  String? // canonical URL or upload filename
  /// Full CanonicalQuiz blob — see lib/synthetic/types.ts.
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

model TeacherProfile {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  title        String?
  bio          String?
  subjects     String[]
  languages    String[]
  hourlyRate   Decimal  @db.Decimal(10, 2)
  paypalEmail  String?
  isActive     Boolean  @default(true)
  rating       Float    @default(0)
  totalReviews Int      @default(0)
}

model StudentProfile {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id])
  userId   String  @unique
  country  String?
  timezone String?
}

model Booking {
  id              String        @id @default(cuid())
  student         User          @relation("StudentBookings", fields: [studentId], references: [id])
  studentId       String
  teacher         User          @relation("TeacherBookings", fields: [teacherId], references: [id])
  teacherId       String
  subject         String
  topic           String?
  status          BookingStatus @default(PENDING)
  scheduledFor    DateTime
  durationMinutes Int
  teamsMeetingUrl String?
  whiteboardId    String?
  priceTotal      Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transaction Transaction?
}

model Transaction {
  id              String            @id @default(cuid())
  booking         Booking           @relation(fields: [bookingId], references: [id])
  bookingId       String            @unique
  student         User              @relation("StudentTransactions", fields: [studentId], references: [id])
  studentId       String
  teacher         User              @relation("TeacherTransactions", fields: [teacherId], references: [id])
  teacherId       String
  amountTotal     Decimal           @db.Decimal(10, 2)
  amountTeacher   Decimal           @db.Decimal(10, 2)
  platformFee     Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)
  paypalOrderId   String?
  paypalCaptureId String?
  paypalPayoutId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Certifications models ──────────────────────────────────────────────
// Source of truth for the DB-backed certifications hub. The on-disk
// JSON packs (certifications/questions/*.json) remain the seed corpus
// — they're ingested into CertificationQuestion via the admin route.

/// One certification (e.g. AWS Certified Cloud Practitioner CLF-C02).
model Certification {
  id     String              @id @default(cuid())
  slug   String              @unique
  code   String
  title  String
  vendor CertificationVendor
  level  CertificationLevel
  status CertificationStatus @default(ACTIVE)

  shortDescription String?
  fullDescription  String?

  officialUrl     String
  officialDomain  String
  examGuideUrl    String?
  learningPathUrl String?

  retiredAt       DateTime?
  replacementSlug String?
  pageLastUpdated String?

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  sources   CertificationSource[]
  domains   CertificationDomain[]
  questions CertificationQuestion[]
  sessions  CertificationSession[]
  progress  CertificationProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendor])
  @@index([level])
  @@index([status])
  @@index([isPublished])
  @@index([vendor, level])
}

/// Official vendor source backing a certification (exam guide, docs,
/// learning path, retirement notice). The provenance anchor for every
/// generated question.
model CertificationSource {
  id              String        @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String

  title  String
  url    String
  domain String

  /// e.g. official_exam_guide, official_certification_page,
  /// official_retirement_notice, official_learning_path,
  /// official_docs_index.
  sourceType String

  vendorOwned Boolean @default(true)
  isPrimary   Boolean @default(false)

  rawText         String?   @db.Text
  contentHash     String?
  lastFetchedAt   DateTime?
  pageLastUpdated String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([certificationId, url])
  @@index([certificationId])
  @@index([domain])
}

/// Exam objective domain (e.g. "Security and Compliance") used to
/// organize questions and surface weak-area analytics.
model CertificationDomain {
  id              String        @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String

  name          String
  description   String?
  weightPercent Float?
  sortOrder     Int     @default(0)

  questions CertificationQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificationId])
}

/// A single exam-style practice question. `options`, `correctAnswers`,
/// and `officialRefs` are JSON because their shapes vary (e.g.
/// multi-select answers, multiple official refs). See
/// `lib/certifications/types.ts` for the canonical TS shapes.
model CertificationQuestion {
  id              String        @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String

  domain   CertificationDomain? @relation(fields: [domainId], references: [id])
  domainId String?

  questionType QuestionType       @default(SINGLE_CHOICE)
  difficulty   QuestionDifficulty @default(MEDIUM)

  prompt         String   @db.Text
  /// Array of { key: "A"|"B"|..., text: string }. JSON for shape flexibility.
  options        Json
  /// Letter keys of the correct option(s) — e.g. ["A"] or ["A","C"].
  correctAnswers String[]
  explanation    String   @db.Text

  /// Array of { title, url, sourceId? } — vendor-owned references.
  officialRefs Json

  tags          String[]
  isAiGenerated Boolean  @default(false)
  isReviewed    Boolean  @default(false)
  isPublished   Boolean  @default(false)

  createdBy  String?
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers CertificationAnswer[]

  @@index([certificationId])
  @@index([domainId])
  @@index([difficulty])
  @@index([isPublished])
}

/// One quiz session for a learner (signed in or guest-by-uuid).
model CertificationSession {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  /// Opaque guest identifier (cookie/localStorage). Only set when userId is null.
  guestId String?

  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String

  mode   SessionMode
  status SessionStatus @default(IN_PROGRESS)

  /// Frozen list of question ids served to the learner so the order is
  /// reproducible across reloads.
  questionIds  String[]
  currentIndex Int      @default(0)

  totalQuestions Int
  correctCount   Int @default(0)
  incorrectCount Int @default(0)
  skippedCount   Int @default(0)

  scorePercent   Float?
  passingPercent Float  @default(70)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  answers CertificationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestId])
  @@index([certificationId])
  @@index([status])
}

/// One learner answer within a session. Upserted on (sessionId, questionId)
/// so re-answering the same question replaces the prior selection.
model CertificationAnswer {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  session   CertificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  question   CertificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  selectedAnswers String[]
  isCorrect       Boolean
  timeSpentMs     Int?
  /// Free-form self-rating: "known" | "review" | "unsure".
  selfRating      String?

  answeredAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
}

/// Per-(user, certification) progress summary. One row per learner per
/// cert; updated each time a session finishes.
model CertificationProgress {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String

  totalSessions     Int @default(0)
  completedSessions Int @default(0)

  bestScore    Float?
  averageScore Float?
  lastScore    Float?

  questionsSeen    Int @default(0)
  questionsCorrect Int @default(0)

  /// JSON arrays of { domainId, name, accuracy } summaries.
  weakDomains   Json @default("[]")
  strongDomains Json @default("[]")

  lastPracticedAt DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([userId, certificationId])
  @@index([userId])
  @@index([certificationId])
}

// ─── WikiTest persistence ───────────────────────────────────────────
// Snapshots the generated WikiTest payload (identical shape to the
// public `WikiTest` TS type) so the learner's library survives the
// 24 h in-memory cache. Attempts are stored separately so multiple
// attempts of the same test are tracked.

model WikiTestSnapshot {
  /// Deterministic content hash — same id the in-memory cache uses.
  id     String  @id
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  title         String
  language      String
  canonicalUrl  String?
  /// Full WikiTest payload (questions + meta) as JSON.
  payload       Json
  /// Question count denormalised for fast list rendering.
  questionCount Int     @default(0)
  difficulty    String
  format        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts WikiAttemptRow[]

  @@index([userId, createdAt])
}

model WikiAttemptRow {
  id      String  @id @default(cuid())
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String?
  /// Guest identifier when userId is null (cookie/localStorage).
  guestId String?

  test   WikiTestSnapshot @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId String

  /// Full attempt payload — answers[], startedAt, finishedAt. JSON to
  /// avoid churning the schema as the per-question feedback grows.
  payload Json

  /// Computed grading summary (set on finalize).
  scorePercent   Float?
  correctCount   Int?
  totalQuestions Int?
  finishedAt     DateTime?
  /// Per-section accuracy summary (JSON: { sectionHeading: percent }[]).
  sectionSummary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([testId])
}

// ─── Thesis defense subsystem ───────────────────────────────────────
// Multi-source defense rehearsal: upload sources (PDFs/URLs/notes),
// run Socratic Q+A, mock defense with a 3-persona committee, then a
// transcript-grounded readiness report. Reuses the synthetic-wizard
// upload + chunking machinery and the AI provider chain.

enum DefenseSessionStatus {
  PLANNING
  STUDY
  MOCK
  COMPLETED
  ARCHIVED
}

enum DefenseRoundKind {
  SOCRATIC
  MOCK_DEFENSE
}

model DefenseSession {
  id      String  @id @default(cuid())
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String?
  /// Guest identifier (cookie-managed) when userId is null.
  guestId String?

  title          String
  thesisAbstract String? @db.Text

  status    DefenseSessionStatus @default(PLANNING)
  /// JSON: [{ id, title, kind: "url"|"upload"|"note", ref, addedAt }].
  /// Mirrors the wizard source picker; bytes for uploads live in the
  /// synthetic upload store and are referenced by uploadId.
  sources   Json                 @default("[]")
  /// JSON committee config — array of personas the mock defense uses.
  /// Each: { id, role, name, voice, focusAreas[] }.
  committee Json                 @default("[]")

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  rounds    DefenseRound[]
  readiness DefenseReadiness?

  @@index([userId, startedAt])
  @@index([guestId, startedAt])
}

model DefenseRound {
  id        String         @id @default(cuid())
  session   DefenseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  kind      DefenseRoundKind
  /// Persona id from the parent's committee[] when kind=MOCK_DEFENSE;
  /// "tutor" for SOCRATIC.
  personaId String

  /// Persona-issued question.
  question String  @db.Text
  /// Learner answer (free text, or STT transcription).
  answer   String? @db.Text

  /// AI rubric scoring of the answer once provided.
  /// { score: 0-5, strengths[], gaps[], followUp?: string }.
  feedback           Json?
  /// Token spans from sources that the answer should have cited.
  groundingCitations Json  @default("[]")

  /// Ordering within the session.
  position   Int
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([sessionId, position])
}

model DefenseReadiness {
  /// 1:1 with DefenseSession.
  sessionId String         @id
  session   DefenseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Overall 0-100 readiness from rubric average.
  scorePercent   Float
  /// JSON: per-source coverage — { sourceId, name, coverage: 0..1 }.
  sourceCoverage Json   @default("[]")
  /// JSON: weak topic areas with suggested rehearsal — { topic, why, suggested }.
  weakAreas      Json   @default("[]")
  /// Markdown narrative summarising the readiness report.
  narrative      String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── LetterForge subsystem ─────────────────────────────────────────
// Stores the master letter-tracing glyphs (guide paths) and the
// soft-scored attempts from Milo Letters on tablet / mobile.
// Philosophy: store letters as guide paths with a generous tolerance
// zone; the evaluator (lib/letterforge/evaluator.ts) never returns
// below "great_try". See lib/letterforge/types.ts for the JSON shapes.

enum GlyphStatus {
  DRAFT
  REVIEW
  LIVE
  RETIRED
}

/// One teachable letter / glyph in one language for one world (3-6,
/// cursive, etc.). The `strokes` JSON column carries the multi-segment
/// guide paths; coordinates are normalized to a 540×540 grid.
model LetterforgeGlyph {
  id             String  @id @default(cuid())
  /// Stable URL slug, e.g. "A-en-little".
  slug           String  @unique
  /// The character itself, supports unicode (A, ñ, あ, أ).
  character      String
  language       String // BCP-47 short tag: en, es, fr, ja, ar, …
  world          String  @default("little_learner")
  displayName    String?
  audioUrl       String?
  rewardImageUrl String?
  rewardWord     String? // "Apple", "Árbol", "あめ" …
  rewardEmoji    String? // "🍎"

  /// Array of { order, guide_path: [[x,y], ...], start_marker, direction_arrow_points }.
  /// Coordinates on a 540×540 normalized grid.
  strokes         Json
  /// Tolerance radius (px on the normalized grid) for the soft scoring.
  toleranceRadius Int  @default(40)

  difficulty   Int         @default(1)
  relatedWords String[]
  status       GlyphStatus @default(LIVE)

  /// Free-form admin tags (e.g. ["phonics","beginner"]).
  tags String[]

  createdBy  String?
  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress LetterforgeProgress[]
  attempts LetterforgeAttempt[]

  @@unique([character, language, world])
  @@index([language, world, status])
  @@index([status])
}

/// One row per (learner, glyph). Tracks attempts and the simple
/// sticker flag the child sees on screen.
model LetterforgeProgress {
  id        String  @id @default(cuid())
  /// Signed-in learner or null for guests (use guestId).
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  /// Guest identifier (cookie/localStorage). Set when userId is null.
  guestId   String?
  /// Parent-facing learner profile id (Sofia, etc.) — separate from the
  /// account holder so multiple kids share one parent account.
  learnerId String

  glyph   LetterforgeGlyph @relation(fields: [glyphId], references: [id], onDelete: Cascade)
  glyphId String

  timesAttempted Int       @default(0)
  bestStars      Int       @default(0)
  stickerEarned  Boolean   @default(false)
  lastAttemptAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learnerId, glyphId])
  @@index([userId, lastAttemptAt])
  @@index([guestId, lastAttemptAt])
  @@index([learnerId])
}

/// Append-only log of tracing attempts. Used by the parent dashboard
/// and to improve the curriculum over time. Never read by the
/// child-facing experience.
model LetterforgeAttempt {
  id        String  @id @default(cuid())
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  guestId   String?
  learnerId String

  glyph   LetterforgeGlyph @relation(fields: [glyphId], references: [id], onDelete: Cascade)
  glyphId String

  /// Full attempt payload: strokes[].points[] {x,y,timestamp}.
  /// Capped at 5 KB by the API so this column stays bounded.
  payload    Json
  result     String // "great_tracing" | "nice_start" | "incomplete_tap"
  stars      Int
  /// Optional per-check breakdown for analytics.
  evalDetail Json?

  createdAt DateTime @default(now())

  @@index([learnerId, createdAt])
  @@index([glyphId, createdAt])
}

// ─── Builder Academy ────────────────────────────────────────────────────
// Powers the enterprise-grade Builder portal at /learn/builder. Each
// BuilderMission is a project-scoped objective ("Build a calculator in
// Python"); steps follow the canonical 6-stage loop
// (Hook → Explain → Practice → Feedback → Reflect → Evolve), with each
// step unlocked sequentially once the previous one is COMPLETED.
//
// Achievements are evaluated by `lib/builder/achievements.ts` whenever
// a step completes. The Prisma rows here are the source of truth; the
// live page falls back to a static seed when no rows exist so the
// portal renders cleanly out of the box.

enum BuilderStepType {
  HOOK
  EXPLAIN
  PRACTICE
  FEEDBACK
  REFLECT
  EVOLVE
}

enum BuilderProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model BuilderMission {
  id               String   @id @default(cuid())
  /// URL-safe identifier ("python-calculator"). Used by the live route
  /// when deep-linking a learner into a specific mission.
  slug             String   @unique
  title            String
  description      String
  /// e.g. "Python", "Math", "Logic" — surfaced on the dashboard pill.
  category         String
  /// Ordering on the dashboard / mission list. Lower = earlier.
  order            Int      @default(0)
  /// Bonus XP awarded when the final step (EVOLVE) is completed.
  xpReward         Int      @default(60)
  /// Rough completion time displayed on the mission card.
  estimatedMinutes Int      @default(30)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  steps BuilderStep[]

  @@index([isPublished, order])
}

model BuilderStep {
  id        String          @id @default(cuid())
  mission   BuilderMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String
  /// 1-indexed order within the mission. Combined with `type` this gives
  /// the 6-step loop (Hook=1 … Evolve=6 by convention).
  order     Int
  type      BuilderStepType
  title     String
  /// Flexible content blob — prose, code, quiz items, etc. Shape is
  /// owned by `lib/builder/content.ts`; the API never inspects it.
  content   Json            @default("{}")
  xp        Int             @default(10)

  progress BuilderStepProgress[]

  @@unique([missionId, order])
  @@index([missionId, type])
}

model BuilderStepProgress {
  id          String                @id @default(cuid())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  step        BuilderStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId      String
  status      BuilderProgressStatus @default(NOT_STARTED)
  startedAt   DateTime              @default(now())
  completedAt DateTime?

  @@unique([userId, stepId])
  @@index([userId, status])
}

model BuilderAchievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String // emoji or lucide name
  /// e.g. { "stepType": "PRACTICE", "count": 5 } or { "missionsCompleted": 3 }
  criteria    Json
  createdAt   DateTime @default(now())

  users UserBuilderAchievement[]
}

model UserBuilderAchievement {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   BuilderAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime           @default(now())

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}
